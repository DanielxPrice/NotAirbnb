# Copy to server/.env for running Node directly.
MONGODB_URI=mongodb://127.0.0.1:27017/notairbnb
PORT=4000
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY=0
UPLOAD_DIR=./uploads
# Local disk for development; use cloudinary for free Render hosting.
UPLOAD_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional local seed account; seed never runs automatically.
SEED_HOST_EMAIL=
SEED_HOST_PASSWORD=
